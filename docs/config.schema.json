      "default": 21,
      "exclusiveMinimum": 0,
      "title": "Horizon Days",
      "type": "integer"
     },
     "max_replies_per_thread": {
      "default": 1,
      "minimum": 1,
      "title": "Max Replies Per Thread",
      "type": "integer"
     },
     "mode": {
      "default": "shadow",
      "enum": [
       "shadow",
       "live"
      ],
      "title": "Mode",
      "type": "string"
     }
    },
    "title": "AutoReply",
    "type": "object"
   },
