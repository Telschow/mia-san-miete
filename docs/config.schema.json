{
 "config": {
  "$defs": {
   "Alerts": {
    "additionalProperties": false,
    "description": "Inbox that receives portal alert emails (saved-search notifications).",
    "properties": {
     "folder": {
      "default": "INBOX",
      "title": "Folder",
      "type": "string"
     },
     "imap_host": {
      "title": "Imap Host",
      "type": "string"
     },
     "imap_port": {
      "default": 993,
      "title": "Imap Port",
      "type": "integer"
     },
     "lookback_days": {
      "default": 3,
      "exclusiveMinimum": 0,
      "title": "Lookback Days",
      "type": "integer"
     },
     "password_env": {
      "title": "Password Env",
      "type": "string"
     },
     "sender_domains": {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "title": "Sender Domains",
      "type": "array"
     },
     "username_env": {
      "title": "Username Env",
      "type": "string"
     }
    },
    "required": [
     "imap_host",
     "username_env",
     "password_env",
     "sender_domains"
    ],
    "title": "Alerts",
    "type": "object"
   },
   "Area": {
    "additionalProperties": false,
    "description": "Where a flat may be. Every part is optional. Postcode and district lists need no network;\nthe radius needs the flat and the center placed on a map. An unknown location goes to\nreview, never to reject.",
    "properties": {
     "center": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Center"
     },
     "exclude_districts": {
      "items": {
       "type": "string"
      },
      "title": "Exclude Districts",
      "type": "array"
     },
     "exclude_postal_codes": {
      "items": {
       "type": "string"
      },
      "title": "Exclude Postal Codes",
      "type": "array"
     },
     "include_postal_codes": {
      "items": {
       "type": "string"
      },
      "title": "Include Postal Codes",
      "type": "array"
     },
     "max_km": {
      "anyOf": [
       {
        "exclusiveMinimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Max Km"
     }
    },
    "title": "Area",
    "type": "object"
   },
   "AutoReply": {
    "additionalProperties": false,
    "description": "Automatic answer to a landlord's viewing offer. Off by default; shadow first.",
    "properties": {
     "daily_cap": {
      "default": 5,
      "minimum": 0,
      "title": "Daily Cap",
      "type": "integer"
