     },
     "targets": {
      "items": {
       "$ref": "#/$defs/Target"
      },
      "minItems": 1,
      "title": "Targets",
      "type": "array"
     }
    },
    "required": [
     "targets",
     "borderline_margin_minutes",
     "pt_router",
     "car_router"
    ],
    "title": "Commute",
    "type": "object"
   },
